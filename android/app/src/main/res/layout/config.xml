<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0f172a">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Claude Remote"
        android:textColor="#e2e8f0"
        android:textSize="24sp"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dirección del servidor (IP:puerto)"
        android:textColor="#94a3b8"
        android:textSize="14sp"
        android:paddingBottom="16dp" />

    <EditText
        android:id="@+id/serverUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="100.x.y.z:3000"
        android:textColorHint="#64748b"
        android:textColor="#e2e8f0"
        android:inputType="textUri"
        android:paddingBottom="16dp" />

    <CheckBox
        android:id="@+id/useTailnet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tailscale integrado (sin la app de Tailscale)"
        android:textColor="#e2e8f0"
        android:buttonTint="#10b981"
        android:paddingTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Con Tailscale integrado podés usar el nombre de la PC (MagicDNS), p. ej. mi-pc:3000"
        android:textColor="#64748b"
        android:textSize="12sp"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/authKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Clave tskey-auth-… (opcional; si no, login en el navegador)"
        android:textColorHint="#64748b"
        android:textColor="#e2e8f0"
        android:textSize="13sp"
        android:inputType="textVisiblePassword"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/saveBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Conectar" />
</LinearLayout>
